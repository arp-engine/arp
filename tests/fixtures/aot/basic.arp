import math_dep
import host

def add(a: int, b: int) -> int:
    return a + b

def add_then_increment(a: int, b: int) -> int:
    return add(a, b) + 1

def sum_loop(count: int) -> int:
    var index: int = 0
    var total: int = 0
    while index < count:
        total = total + index
        index = index + 1
    return total

def append_then_length() -> int:
    var values: [int] = []
    append(values, 7)
    return values.length()

def multiply_from_dependency(a: int, b: int) -> int:
    return math_dep.multiply(a, b)

def dependency_constant() -> int:
    return math_dep.SCALE

def reflected_get(receiver: any, value: any) -> any:
    return receiver.get(value)

def yielded_reflected(receiver: any, value: any) -> any:
    yield 1
    return receiver.get(value)

def closure_accumulate(start: int) -> int:
    var value: int = start
    var read: () -> int = lambda() -> int: value
    value = value + 5
    return read()

def handled_raise() -> int:
    try:
        raise "expected"
    except as error:
        return 7
    return 0

def raise_from_child() -> int:
    raise "child failure"
    return 0

def handled_child_raise() -> int:
    try:
        return raise_from_child()
    except as error:
        return 8
    return 0

def handled_divide_by_zero() -> int:
    try:
        return 10 / 0
    except as error:
        return 9
    return 0

def count_two(start: int) -> int:
    yield start
    yield start + 1
    return start + 2

def handled_generator_throw() -> int:
    try:
        yield 1
    except as error:
        yield 2
    return 3

def await_then_yield(gate: any) -> int:
    yield await gate
    return 4

def captured_generator(start: int) -> any:
    var value: int = start
    def produce() -> int:
        yield value
        return value + 1
    value = value + 5
    return produce()

def delegated_child(start: int) -> int:
    yield start
    return start + 1

def delegated_await_child(gate: any) -> int:
    yield await gate
    return 6

def delegated_await_parent(gate: any) -> int:
    yield from delegated_await_child(gate)
    return 9

def delegated_parent(start: int) -> int:
    yield from delegated_child(start)
    return 99

def delegated_pair(start: int) -> int:
    yield from delegated_child(start)
    yield from delegated_child(start + 10)
    return 199

def delegated_with_plain_for(start: int) -> int:
    yield from delegated_child(start)
    for value in [30, 31]:
        yield value
    return 200

def delegated_dynamic_parent(source: any) -> int:
    yield from source
    return 88

def recursive_delegated(depth: int) -> int:
    if depth <= 0:
        yield 1
        return 1
    yield from recursive_delegated(depth - 1)
    return depth

def delegated_import_parent(start: int) -> int:
    yield from math_dep.delegated_import_child(start)
    return 99

def delegated_collection_child() -> any:
    return [4, 7]

def delegated_collection_parent() -> int:
    try:
        yield from delegated_collection_child()
    except as error:
        return 8
    return 9

def native_numeric_sequence(n: int) -> int:
    var x: float = 1.0
    var i: int = 0
    var total: int = 0
    while i < n:
        x = x * 0.5 + 1.0
        if x > 1.5:
            total = total + (i & 7)
        i = i + 1
    return total

def native_private_rebuild(n: int) -> int:
    var i: int = 0
    var total: int = 0
    var part: string = ""
    while i < n:
        var values: [int] = [i, i + 1]
        var dictionary: {int: int} = {0: i, 1: i + 1}
        part = "abc" + "xyz"
        total = total + values[1] + dictionary[0] + len(part)
        i = i + 1
    return total

def native_aliases() -> int:
    var values: [int] = [7, 8]
    var old_values: [int] = values
    var text: string = "abc"
    var old_text: string = text
    values = [9, 10]
    text = text + "xyz"
    return old_values[0] + len(old_text)

def native_leaf_calls(n: int) -> int:
    var offset: int = 3
    def step(value: int) -> int:
        return value + offset
    return step(n)

class NativeLeafBase:
    def step(self, value: int) -> int:
        return value + 1

class NativeLeafDerived(NativeLeafBase):
    def step(self, value: int) -> int:
        return value + 2

class NativeLeafInherited(NativeLeafBase):
    def unused(self, value: int) -> int:
        return value

def native_virtual_leaf(n: int) -> int:
    var object: NativeLeafBase = NativeLeafDerived()
    return object.step(n)

def native_string_lookup(n: int) -> int:
    var values: {string: int} = {"oak": 3, "pine": 5}
    var keys: [string] = ["oak", "pine"]
    var total: int = 0
    var i: int = 0
    while i < n:
        total = total + values[keys[i % 2]]
        i = i + 1
    return total

def native_handled_sequence(n: int) -> int:
    var total: int = 0
    var i: int = 0
    while i < n:
        try:
            total = total + 12 / (i % 2)
        except as error:
            total = total + 1
        i = i + 1
    return total

def native_index_update(n: int) -> int:
    var values: [int] = [0, 0]
    var dictionary: {int: int} = {0: 0, 1: 0}
    var old_values: [int] = values
    var total: int = 0
    var i: int = 0
    while i < n:
        var index: int = i % 2
        values[index] = values[index] + 1
        dictionary[index] = dictionary[index] + 2
        total = total + old_values[index] + dictionary[index]
        i = i + 1
    return total

def native_index_guard(n: int) -> int:
    var values: [int] = [4, 5]
    return values[n] + 1

def native_missing_key(n: int) -> int:
    var values: {int: int} = {0: 1}
    return values[n] + 1

def native_index_alias(n: int) -> int:
    var values: [int] = [n, 3]
    var value: int = values[0]
    return value

def native_rebuild_topology(n: int) -> int:
    var i: int = 0
    var total: int = 0
    while i < n:
        var values: [int] = [i, i + 1]
        var dictionary: {int: int} = {0: i, 1: i + 1}
        total = total + values[1] + dictionary[0]
        if i % 2 == 0:
            values = [i + 2, i + 3, i + 4]
            dictionary = {0: i + 2, 2: i + 3}
            total = total + values[2] + dictionary[2]
        else:
            values = [i + 5]
            dictionary = {0: i + 5}
            total = total + values[0] + dictionary[0]
        i = i + 1
    return total

def native_power_sequence(n: int) -> int:
    var i: int = 0
    var total: int = 0
    while i < n:
        total = total + (i % 5) ** 2 // 2
        i = i + 1
    return total

def native_power_overflow(n: int) -> int:
    return n ** 31

def native_method_loop(n: int) -> int:
    var object: NativeLeafBase = NativeLeafDerived()
    var total: int = 0
    var i: int = 0
    while i < n:
        total = total + object.step(i)
        i = i + 1
    return total

def native_closure_loop(n: int) -> int:
    var offset: int = 3
    def loop_step(value: int) -> int:
        return value + offset
    var total: int = 0
    var i: int = 0
    while i < n:
        total = total + loop_step(i)
        i = i + 1
    return total

def native_string_regions(n: int) -> int:
    var text: string = ""
    var base: string = "aot_pc_1"
    var total: int = 0
    var i: int = 0
    while i < n:
        text = text + "x"
        var part: string = base + "z"
        total = total + len(text) + len(part)
        i = i + 1
    return total

def native_collection_loop(n: int) -> int:
    var total: int = 0
    for i in range(n):
        total = total + i * 2
    return total

def native_loop_index_failure(n: int) -> int:
    var values: [int] = [3, 5]
    var total: int = 0
    var i: int = 0
    while i < n:
        total = total + values[i]
        i = i + 1
    return total

def native_loop_overflow(n: int) -> int:
    var total: int = 1
    var i: int = 0
    while i < n:
        total = total * 1000
        i = i + 1
    return total


def native_inherited_method_loop(n: int) -> int:
    var object: NativeLeafBase = NativeLeafInherited()
    var total: int = 0
    var i: int = 0
    while i < n:
        total = total + object.step(i)
        i = i + 1
    return total


def native_private_index_loop(n: int) -> int:
    var values: [int] = [0, 0]
    var dictionary: {int: int} = {0: 0, 1: 0}
    var total: int = 0
    var i: int = 0
    while i < n:
        var index: int = i % 2
        values[index] = values[index] + 1
        dictionary[index] = dictionary[index] + 2
        total = total + values[index] + dictionary[index]
        i = i + 1
    return total


def native_min_modulo(n: int) -> int:
    return (-2147483647 - 1) % (n - 9)


def native_scalar_branches(n: int) -> int:
    var total: int = 0
    var i: int = 0
    while i < n:
        if i % 2 == 0:
            total = total + i * 2
        else:
            total = total + i
        i = i + 1
    return total


def native_scalar_nested(n: int) -> int:
    var total: int = 0
    var i: int = 0
    while i < n:
        var j: int = 0
        while j < 3:
            total = total + i + j
            j = j + 1
        i = i + 1
    return total


def native_iterated_key_owner(n: int) -> int:
    var dictionary: {string: int} = {"oak": 3, "pine": 5}
    var keys: [string] = ["oak"]
    var sources: [[string]] = [["oak"], ["pine"]]
    var total: int = 0
    for keys in sources:
        total = total + dictionary[keys[0]]
    return total
