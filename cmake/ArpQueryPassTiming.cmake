# Shared by checked-in and generated builds. Timing is an RHI contract, not a
# cloud-specific executor or a renderer-owned native query implementation.
add_executable(arp_query_pass_timing_tests tests/contract/query_pass_timing_tests.cpp)
target_link_libraries(arp_query_pass_timing_tests PRIVATE arp_rhi arp_rhi_semantics)
target_include_directories(arp_query_pass_timing_tests PRIVATE .)
target_compile_options(arp_query_pass_timing_tests PRIVATE -UNDEBUG)
arp_add_mingw_static_runtime(arp_query_pass_timing_tests)
add_test(NAME arp_query_pass_timing_contract COMMAND arp_query_pass_timing_tests)
add_test(NAME arp_query_pass_timing_null_smoke COMMAND arp_query_pass_timing_tests --null-hidden-frame)
set_tests_properties(arp_query_pass_timing_null_smoke PROPERTIES LABELS "rhi;null-smoke")

