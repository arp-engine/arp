# Renderer/UI-owned reuse checks. Keep registration in the generator as well.
if(TARGET arp_gui)
    add_executable(arp_gui_draw_plan_reuse_tests tests/unit/gui_draw_plan_reuse_tests.cpp)
    target_include_directories(arp_gui_draw_plan_reuse_tests PRIVATE src)
    target_link_libraries(arp_gui_draw_plan_reuse_tests PRIVATE arp_core)
    add_test(NAME arp_gui_draw_plan_reuse_tests COMMAND arp_gui_draw_plan_reuse_tests)
    foreach(target IN ITEMS arp_gui_draw_plan_reuse_tests)
        if(MSVC)
            target_compile_options(${target} PRIVATE /UNDEBUG)
        else()
            target_compile_options(${target} PRIVATE -UNDEBUG)
        endif()
        if(MINGW)
            target_link_options(${target} PRIVATE -static-libstdc++ -static-libgcc)
        endif()
    endforeach()
endif()
