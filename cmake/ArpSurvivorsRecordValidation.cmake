add_executable(arp_survivors_record_tests tests/contract/survivors_record_tests.cpp)
target_include_directories(arp_survivors_record_tests PRIVATE . src)
target_link_libraries(arp_survivors_record_tests PRIVATE arp_survivors_records arp_example_startup_files)
target_compile_options(arp_survivors_record_tests PRIVATE -UNDEBUG)
arp_add_mingw_static_runtime(arp_survivors_record_tests)
foreach(mode IN ITEMS tests smoke)
    if(mode STREQUAL "smoke")
        set(args --smoke)
    else()
        set(args)
    endif()
    add_test(NAME arp_survivors_record_${mode} COMMAND arp_survivors_record_tests ${args})
    set_tests_properties(arp_survivors_record_${mode} PROPERTIES TIMEOUT 60 LABELS "example;io;save")
endforeach()
if(WIN32)
    add_test(NAME arp_survivors_record_native_smoke
        COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/contract/survivors_record_native_smoke.py"
            "$<TARGET_FILE:arp_survivors_record_tests>")
    set_tests_properties(arp_survivors_record_native_smoke PROPERTIES TIMEOUT 90 LABELS "example;io;save;smoke")
endif()
