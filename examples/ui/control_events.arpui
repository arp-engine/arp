type: ui.document
contractVersion: ui.document/v1
canvas: { id: control-events-example, width: 720, height: 240, dpi: 96 }
root:
  id: root
  type: Panel
  layer: root
  rect: { x: 0, y: 0, width: 720, height: 240 }
  style: background
  state: enabled
  event: none
  children:
    - id: action
      type: Button
      layer: action
      rect: { x: 20, y: 20, width: 160, height: 36 }
      style: control
      fontToken: font.visual.alpha
      state: enabled
      event: activate
      text: Click
    - id: action_status
      type: Label
      layer: action_status
      rect: { x: 220, y: 20, width: 480, height: 36 }
      style: text
      fontToken: font.visual.alpha
      state: enabled
      event: none
      text: Button ready
    - id: volume
      type: Slider
      layer: volume
      rect: { x: 20, y: 85, width: 160, height: 36 }
      style: control
      state: enabled
      event: volume_changed
    - id: volume_status
      type: Label
      layer: volume_status
      rect: { x: 220, y: 85, width: 480, height: 36 }
      style: text
      fontToken: font.visual.alpha
      state: enabled
      event: none
      text: Slider ready
    - id: entry
      type: TextInput
      layer: entry
      rect: { x: 20, y: 150, width: 160, height: 36 }
      style: text
      fontToken: font.visual.alpha
      state: enabled
      event: text_changed
    - id: entry_status
      type: Label
      layer: entry_status
      rect: { x: 220, y: 150, width: 480, height: 36 }
      style: text
      fontToken: font.visual.alpha
      state: enabled
      event: none
      text: Text ready
