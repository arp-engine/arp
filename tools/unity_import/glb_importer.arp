import unity_import_common
import asset
import io
import yaml
import arp_import_host
import importer_base
import glb_source_profile


class GlbImporter(Importer):
    def import_path(self, path: string) -> asset.ImportedModelResult:
        var options: asset.GlbSourceOptions = glb_source_profile.make_options()
        var diagnostic: string = options.validate()
        if diagnostic != "":
            raise unity_import_common.DIAGNOSTIC_GLB_IMPORT + ": " + diagnostic
        var acquired: io.IoBinaryResult = io.read_binary_local(
            path, options.maxSourceBytes, glb_source_profile.local_acquisition_bytes(options))
        if not acquired.success:
            raise unity_import_common.DIAGNOSTIC_GLB_IMPORT + ": " + acquired.diagnostics
        return asset.import_glb_bytes(path, acquired.data(), options)

    def run(self, path: string) -> int:
        var imported: asset.ImportedModelResult = self.import_path(path)
        if not imported.success:
            raise unity_import_common.DIAGNOSTIC_GLB_IMPORT + ": " + imported.diagnostics
        return unity_import_common.STATUS_OK

    def export_path(self, input: string, output: string) -> int:
        var imported: asset.ImportedModelResult = self.import_path(input)
        if not imported.success:
            raise unity_import_common.DIAGNOSTIC_GLB_IMPORT + ": " + imported.diagnostics
        var report: yaml.YamlDocument = self.make_report(
            input, unity_import_common.REPORT_KIND_GLB, unity_import_common.STATUS_OK)
        self.add_model_summary(report, imported)
        return self.write_report(output, report)

