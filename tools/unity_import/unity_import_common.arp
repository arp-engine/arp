# YAML node kind codes are part of the yaml module contract.
const YAML_KIND_UNDEFINED: int = -1
const YAML_KIND_NULL: int = 0
const YAML_KIND_MAPPING: int = 1
const YAML_KIND_SEQUENCE: int = 2
const YAML_KIND_STRING: int = 3

def read_text_or_raise(path: string) -> string:
    var result: io.IoTextResult = io.read_text(path)
    if not result.success:
        raise DIAGNOSTIC_SOURCE_READ + ": " + path + ": " + result.diagnostics
    return result.text

def parse_yaml_or_raise(text: string) -> yaml.YamlParseResult:
    var result: yaml.YamlParseResult = yaml.parse(text)
    if not result.success:
        raise DIAGNOSTIC_YAML_PARSE + ": " + result.diagnostics
    return result

def first_document_or_raise(text: string) -> yaml.YamlDocument:
    parse_yaml_or_raise(text)
    var document: yaml.YamlDocument = yaml.first_document(text)
    if yaml.kind_code(document) < YAML_KIND_NULL:
        raise DIAGNOSTIC_YAML_EMPTY
    return document

def write_text_or_raise(path: string, text: string) -> void:
    var result: io.IoOperationResult = io.write_text(path, text)
    if not result.success:
        raise DIAGNOSTIC_REPORT_WRITE + ": " + path + ": " + result.diagnostics

def list_paths_or_raise(root: string, recursive: bool) -> io.IoFileList:
    var result: io.IoFileList = io.list_paths(root, recursive)
    if not result.success:
        raise DIAGNOSTIC_SOURCE_READ + ": " + root + ": " + result.diagnostics
    return result

def resolve_project_asset_or_raise(
    projectRoot: string,
    assetPath: string,
    diagnostic: string) -> string:
    if projectRoot == "" or assetPath == "":
        raise diagnostic + ": missing project asset path"
    var resolved: arp_import_host.PathResult = arp_import_host.resolve_path(
        projectRoot, assetPath)
    if not resolved.success:
        raise diagnostic + ": " + resolved.diagnostics
    if not io.exists(resolved.path):
        raise diagnostic + ": source file is missing: " + assetPath
    return resolved.path

def source_contract() -> int:
    return SOURCE_CONTRACT_VERSION

def input_extension(path: string) -> string:
    return arp_import_host.path_extension(path)

def document_kind(document: yaml.YamlDocument) -> int:
    return yaml.kind_code(document)

def is_undefined(document: yaml.YamlDocument) -> bool:
    return yaml.kind_code(document) < YAML_KIND_NULL

def has_supported_object(document: yaml.YamlDocument) -> bool:
    var gameObject: yaml.YamlDocument = document.get("GameObject")
    if yaml.kind_code(gameObject) == YAML_KIND_MAPPING:
        var name: yaml.YamlDocument = gameObject.get("m_Name")
        if yaml.kind_code(name) == YAML_KIND_STRING:
            var nameText: string = name.string_value()
            if nameText != "":
                return true

    var transform: yaml.YamlDocument = document.get("Transform")
    if yaml.kind_code(transform) == YAML_KIND_MAPPING:
        var gameObjectReference: yaml.YamlDocument = transform.get("m_GameObject")
        if yaml.kind_code(gameObjectReference) == YAML_KIND_MAPPING:
            return true
    return false

def validate_unity_scene(text: string) -> void:
    var parsed: yaml.YamlParseResult = yaml.parse(text)
    if not parsed.success:
        raise DIAGNOSTIC_YAML_PARSE + ": " + parsed.diagnostics
    var documentCount: int = 0
    for document: yaml.YamlDocument in parsed.documents:
        documentCount = documentCount + 1
        var documentKind: int = document_kind(document)
        if documentKind < YAML_KIND_UNDEFINED:
            raise DIAGNOSTIC_YAML_DOCUMENT
    if documentCount == 0:
        raise DIAGNOSTIC_YAML_EMPTY

    var supportedObjectCount: int = 0
    for document: yaml.YamlDocument in parsed.documents:
        var kindCode: int = yaml.kind_code(document)
        if kindCode == YAML_KIND_NULL or kindCode == YAML_KIND_UNDEFINED:
            continue
        if kindCode != YAML_KIND_MAPPING:
            raise DIAGNOSTIC_YAML_DOCUMENT

        if has_supported_object(document):
            supportedObjectCount = supportedObjectCount + 1

    if supportedObjectCount == 0:
        raise DIAGNOSTIC_UNSUPPORTED_OBJECT

def validate_unity_file(path: string) -> void:
    validate_unity_scene(read_text_or_raise(path))

def project_has_assets(projectRoot: string) -> bool:
    var assetsPath: arp_import_host.PathResult = arp_import_host.resolve_path(
        projectRoot, "Assets")
    if not assetsPath.success:
        raise DIAGNOSTIC_ASSET_DATABASE_PATH + ": " + assetsPath.diagnostics
    return io.exists(assetsPath.path)

def validate_project(projectRoot: string) -> void:
    if not project_has_assets(projectRoot):
        return
    var database: asset.UnityAssetDatabaseResult = asset.scan_unity_assets(projectRoot)
    if not database.success:
        raise DIAGNOSTIC_ASSET_DATABASE + ": " + database.diagnostics
